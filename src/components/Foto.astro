---
// Una foto con le tre larghezze WebP create da scripts/foto.mjs.
// nome = nome del file in /foto senza estensione (per i prodotti: "prodotti-<nome>").
interface Props {
  nome: string; alt: string; sizes?: string; class?: string;
  prima?: boolean; style?: string; width?: number; height?: number;
}
const { nome, alt, sizes = '100vw', class: cls, prima = false, style, width = 1280, height = 853 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = (w: number) => `${base}/img/web/${nome}-${w}.webp`;
---
<img
  src={src(1280)}
  srcset={`${src(640)} 640w, ${src(1280)} 1280w`}
  sizes={sizes} alt={alt} class={cls} style={style}
  width={width} height={height}
  loading={prima ? 'eager' : 'lazy'} decoding={prima ? 'sync' : 'async'}
  fetchpriority={prima ? 'high' : undefined}
/>
