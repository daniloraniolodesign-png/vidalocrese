---
import Base from '../layouts/Base.astro';
import Pill from '../components/Pill.astro';
import { gazzettino } from '../lib/dati';
---
<Base
  titolo="Gazzettino di Donna Ida: eventi a Gerace e Locri · Vida Locrese"
  descrizione="Gli eventi e le notizie di Gerace, Locri e dintorni raccontati da Donna Ida, la nonna di Vida Locrese."
  attiva="chi-siamo">

  <section style="display:grid;gap:14px;padding-top:24px">
    <span class="eyebrow"><i></i>Vida Locrese News</span>
    <h1 class="h2" style="font-size:clamp(34px,4vw,52px)">Il gazzettino <b>di Donna Ida</b></h1>
    <p class="lead">Eventi, sagre, cinema e novità della Locride. Donna Ida trasmette notizie sempre belle, più o meno. Ma sempre con affetto!</p>
  </section>

  <section aria-label="Notizie">
    <div class="posts">
      {gazzettino.map((p) => (
        <article class="post">
          <time datetime={p.data}>{p.quando}</time>
          <h2>{p.titolo}</h2>
          <p>{p.testo}</p>
          <p class="firma">Parola di Donna Ida!</p>
          {p.link && <a href={p.link} target="_blank" rel="noopener">{p.link_testo || 'Approfondisci'}<span class="sr"> (si apre in una nuova scheda)</span></a>}
        </article>
      ))}
    </div>
  </section>

  <section class="table" aria-label="Instagram">
    <div><h2 style="font:600 18px/1.2 var(--font)">Le novità anche su Instagram</h2><p>Foto e storie da Vida Locrese.</p></div>
    <Pill href="https://www.instagram.com/vida_locrese" testo="@vida_locrese" esterno />
  </section>
</Base>
